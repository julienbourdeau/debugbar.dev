---
import Base from './Base.astro';
import DocsToc from '../components/DocsToc.astro';

interface Props {
  title: string;
  subtitle?: string;
  tocSection: string;
  seoTitle?: string;
  seoDescription?: string;
  currentSlug: string;
}

const { title, subtitle, tocSection, seoTitle, seoDescription, currentSlug } = Astro.props;
---

<Base title={title} seoTitle={seoTitle} seoDescription={seoDescription}>

  <div class="space-y-12 lg:flex lg:justify-between lg:space-y-0">
    <aside x-data="{ tocOpen: false }" id="docs-table-of-content" class="shadow-sm p-3 border lg:border-0 lg:min-w-64 lg:mr-20 lg:shadow-none">
      <h2 @click="tocOpen = true" class="cursor-pointer lg:cursor-auto text-xl font-semibold leading-10">Table of contents</h2>

      <div x-show="tocOpen" @click.away="tocOpen = false" class="lg:hidden">
        <DocsToc currentSlug={currentSlug} />
      </div>

      <div class="hidden lg:block">
        <DocsToc currentSlug={currentSlug} />
      </div>

    </aside>

    <div class="w-full">
      <article>
        <header class="mb-12 space-y-1">
          <div class="flex items-start justify-between gap-4">
            <div class="space-y-1">
              <p class="font-display text-sm font-medium text-orange-600">{tocSection}</p>
              <h1 class="font-display text-4xl font-bold tracking-tight text-stone-900">{title}</h1>
              {subtitle && (
                <h2 class="font-display text-lg tracking-tight text-stone-600">{subtitle}</h2>
              )}
            </div>
            <div
              x-data="{ copied: false }"
              class="flex shrink-0 gap-1.5 pt-5"
            >
              <a
                href={`/docs/${currentSlug}.md`}
                target="_blank"
                class="inline-flex items-center gap-1 rounded-md border border-stone-200 bg-white px-2.5 py-1.5 text-xs font-medium text-stone-600 hover:bg-stone-50 hover:text-stone-900 transition-colors"
                title="View raw Markdown"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M2 3.75C2 2.784 2.784 2 3.75 2h8.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 12.25 14h-8.5A1.75 1.75 0 0 1 2 12.25Zm6.22 1.97a.75.75 0 0 1 1.06 0l2.25 2.25a.75.75 0 0 1 0 1.06l-2.25 2.25a.748.748 0 0 1-1.06-1.06L9.94 8.5 8.22 6.78a.75.75 0 0 1 0-1.06ZM5.06 5.72a.75.75 0 0 1 0 1.06L3.34 8.5l1.72 1.72a.748.748 0 0 1-1.06 1.06l-2.25-2.25a.75.75 0 0 1 0-1.06l2.25-2.25a.75.75 0 0 1 1.06 0Z"/></svg>
                .md
              </a>
              <button
                @click={`
                  fetch('/docs/${currentSlug}.md')
                    .then(r => r.text())
                    .then(t => navigator.clipboard.writeText(t))
                    .then(() => { copied = true; setTimeout(() => copied = false, 2000) })
                `}
                :class="copied ? 'border-green-300 bg-green-50 text-green-700' : 'border-stone-200 bg-white text-stone-600 hover:bg-stone-50 hover:text-stone-900'"
                class="inline-flex items-center gap-1 rounded-md border px-2.5 py-1.5 text-xs font-medium transition-colors cursor-pointer"
                title="Copy page as Markdown"
              >
                <template x-if="!copied">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25ZM5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"/></svg>
                </template>
                <template x-if="copied">
                  <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"/></svg>
                </template>
                <span x-text="copied ? 'Copied!' : 'Copy'"></span>
              </button>
            </div>
          </div>
        </header>

        <div class="prose lg:prose-lg prose-stone max-w-none prose-headings:scroll-mt-28 prose-headings:font-display prose-headings:font-normal lg:prose-headings:scroll-mt-34 prose-lead:text-stone-500 prose-a:font-semibold prose-a:hover:[--tw-prose-underline-size:6px] prose-pre:rounded-xl prose-pre:bg-stone-900 prose-pre:shadow-sm">

          <slot />

        </div>
      </article>
    </div>
  </div>

</Base>
