---
interface Props {
  title?: string;
  seoTitle?: string;
  description?: string;
  seoDescription?: string;
  canonicalUrl?: string;
}

const siteDescription = 'Rails debugging dev tools for faster development. Inspect your request details (queries, logs, cache, jobs and more).';

const { title, seoTitle, description, seoDescription, canonicalUrl } = Astro.props;

const pageTitle = seoTitle || (title ? `${title} | Ruby On Rails Debugbar` : 'Debugbar For Ruby on Rails');
const pageDescription = seoDescription || description || siteDescription;
const seoGraphImg = new URL('/assets/debugbar-graph-img.png', Astro.site || Astro.url);
const canonical = canonicalUrl || Astro.url.href;
---

<title>{pageTitle}</title>
<meta property="og:title" content={pageTitle} />

{pageDescription && (
  <>
    <meta name="description" content={pageDescription} />
    <meta property="og:description" content={pageDescription} />
  </>
)}

<link rel="canonical" href={canonical} />
<meta property="og:url" content={canonical} />

<meta name="twitter:creator" content="@julienbourdeau" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="image" content={seoGraphImg.href} />
<meta itemprop="image" content={seoGraphImg.href} />
<meta name="twitter:image" content={seoGraphImg.href} />
<meta property="og:image" content={seoGraphImg.href} />
