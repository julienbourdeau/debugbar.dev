---
import Base from '../layouts/Base.astro';
import { fetchChangelog } from '../lib/build-helpers';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';

const processor = await createMarkdownProcessor({
  shikiConfig: { theme: 'github-light' },
});

const changelog = await fetchChangelog();
const { code: html } = await processor.render(changelog);
---

<Base seoTitle="Rails Debugbar Changelog" seoDescription="All new features, improvements and fixes in Debugbar and more importantly: all the breaking changes!">

  <div class="prose max-w-none">

    <Fragment set:html={html} />

  </div>

</Base>
